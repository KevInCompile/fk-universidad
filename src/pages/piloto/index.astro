---
import PilotoShell from "../../components/piloto/PilotoShell.astro";
---

<PilotoShell
  titulo="Mi panel"
  eyebrow="Portal del piloto"
  descripcion="Datos del piloto, estado de la licencia e inscripciones."
>
  <div id="panel" class="space-y-10">
    <p class="font-mono text-xs uppercase tracking-widest text-muted-foreground">
      Cargando datos del piloto…
    </p>
  </div>

  <noscript>
    <p class="mt-6 border border-destructive px-4 py-3 font-mono text-xs uppercase tracking-widest text-destructive">
      Este panel necesita JavaScript: los datos del prototipo se guardan en el
      navegador.
    </p>
  </noscript>
</PilotoShell>

<script>
  import { obtenerPiloto, licenciaDe } from "../../lib/store";
  import { sesionPiloto } from "../../components/piloto/sesion";
  import { ETIQUETA_ESTADO_LICENCIA } from "../../lib/types";
  import {
    escapar,
    formatoFecha,
    claseEstadoLicencia,
  } from "../../components/piloto/ui";

  const panel = document.querySelector<HTMLDivElement>("#panel");

  function dato(etiqueta: string, valor: string): string {
    return `
      <div class="bg-card px-5 py-4">
        <p class="font-mono text-[10px] uppercase tracking-widest text-muted-foreground">${etiqueta}</p>
        <p class="mt-1 text-lg">${valor}</p>
      </div>`;
  }

  function pintarError(mensaje: string): void {
    if (!panel) return;
    panel.innerHTML = `
      <div class="border border-destructive bg-destructive/10 p-6">
        <p class="font-mono text-xs uppercase tracking-widest text-destructive">${mensaje}</p>
        <a href="/login" class="mt-4 inline-block border border-foreground px-6 py-3 font-mono text-xs uppercase tracking-widest transition-colors hover:bg-foreground hover:text-background">Ir al login</a>
      </div>`;
  }

  function iniciar(): void {
    const sesion = sesionPiloto();
    if (!sesion || !panel) return;

    const pilotoId = sesion.pilotoId;
    if (!pilotoId) {
      pintarError("Tu sesión no tiene un piloto asociado. Volvé a iniciar sesión.");
      return;
    }

    const piloto = obtenerPiloto(pilotoId);
    if (!piloto) {
      pintarError("No encontramos sus datos de piloto. Regístrese de nuevo.");
      return;
    }

    const licencia = licenciaDe(pilotoId);
    const estado = licencia ? licencia.estado : "sin_solicitud";
    const etiqueta = ETIQUETA_ESTADO_LICENCIA[estado];

    const acciones: string[] = [];
    if (estado === "sin_solicitud" || estado === "rechazada") {
      acciones.push(`
        <a href="/piloto/licencia" class="group flex flex-col justify-between border border-primary bg-primary p-6 text-primary-foreground transition-opacity hover:opacity-90">
          <span class="font-mono text-xs uppercase tracking-widest">Licencia</span>
          <span class="mt-8 font-display text-3xl uppercase leading-none">Solicitar licencia →</span>
          <span class="mt-3 font-mono text-[10px] uppercase tracking-widest">Cargue el documento y la fotografía</span>
        </a>`);
    } else if (estado === "en_validacion") {
      acciones.push(`
        <a href="/piloto/licencia" class="group flex flex-col justify-between border border-border bg-card p-6 transition-colors hover:bg-secondary">
          <span class="font-mono text-xs uppercase tracking-widest text-muted-foreground">Licencia</span>
          <span class="mt-8 font-display text-3xl uppercase leading-none">Ver solicitud →</span>
          <span class="mt-3 font-mono text-[10px] uppercase tracking-widest text-muted-foreground">En revisión por la directiva</span>
        </a>`);
    } else {
      acciones.push(`
        <a href="/piloto/licencia-activa" class="group flex flex-col justify-between border border-primary bg-primary p-6 text-primary-foreground transition-opacity hover:opacity-90">
          <span class="font-mono text-xs uppercase tracking-widest">Licencia</span>
          <span class="mt-8 font-display text-3xl uppercase leading-none">Licencia activa →</span>
          <span class="mt-3 font-mono text-[10px] uppercase tracking-widest">Descargable e imprimible</span>
        </a>`);
    }

    acciones.push(`
      <a href="/piloto/inscripciones" class="group flex flex-col justify-between border border-border bg-card p-6 transition-colors hover:bg-secondary">
        <span class="font-mono text-xs uppercase tracking-widest text-muted-foreground">Eventos</span>
        <span class="mt-8 font-display text-3xl uppercase leading-none">Inscripciones →</span>
        <span class="mt-3 font-mono text-[10px] uppercase tracking-widest text-muted-foreground">Por búsqueda o código QR</span>
      </a>`);

    panel.innerHTML = `
      <section>
        <div class="mb-6 flex items-center gap-4">
          <span class="checker-sm h-4 w-8" aria-hidden="true"></span>
          <h2 class="font-mono text-xs uppercase tracking-[0.3em] text-muted-foreground">Tarjeta de identidad</h2>
          <span class="h-px flex-1 bg-border" aria-hidden="true"></span>
        </div>

        <div class="border border-border bg-card">
          <div class="flex flex-col gap-2 border-b border-border px-6 py-6 md:flex-row md:items-end md:justify-between">
            <div>
              <p class="font-mono text-xs uppercase tracking-widest text-muted-foreground">Identificador único de piloto</p>
              <p class="mt-2 font-display text-4xl uppercase tracking-wide text-primary md:text-5xl">${escapar(piloto.id)}</p>
            </div>
            <p class="font-mono text-[10px] uppercase tracking-widest text-muted-foreground">Alta: ${formatoFecha(piloto.creadoEn)}</p>
          </div>

          <div class="grid gap-px bg-border sm:grid-cols-2 lg:grid-cols-3">
            ${dato("Nombre", escapar(piloto.nombre))}
            ${dato("Documento", escapar(piloto.documento))}
            ${dato("Correo electrónico", escapar(piloto.email))}
            ${dato("Teléfono", escapar(piloto.telefono))}
            ${dato("Fecha de nacimiento", formatoFecha(piloto.fechaNacimiento))}
            ${dato("Rol", "Piloto")}
          </div>
        </div>
      </section>

      <section>
        <div class="mb-6 flex items-center gap-4">
          <span class="checker-sm h-4 w-8" aria-hidden="true"></span>
          <h2 class="font-mono text-xs uppercase tracking-[0.3em] text-muted-foreground">Estado de la licencia</h2>
          <span class="h-px flex-1 bg-border" aria-hidden="true"></span>
        </div>

        <div class="border border-border bg-card p-6">
          <div class="flex flex-wrap items-center gap-4">
            <span class="inline-flex items-center px-4 py-2 font-mono text-xs uppercase tracking-widest ${claseEstadoLicencia(estado)}">${etiqueta}</span>
            ${
              estado === "sin_solicitud"
                ? `<p class="font-mono text-xs uppercase tracking-widest text-muted-foreground">Todavía no solicitaste tu licencia</p>`
                : ""
            }
          </div>

          ${
            licencia
              ? `<div class="mt-6 grid gap-px bg-border sm:grid-cols-2 lg:grid-cols-4">
                  ${dato("Categoría", escapar(licencia.categoria))}
                  ${dato("Fecha de solicitud", formatoFecha(licencia.solicitadaEn))}
                  ${dato("Fecha de validación", licencia.validadaEn ? formatoFecha(licencia.validadaEn) : "Pendiente")}
                  ${dato("Observación", licencia.observacion ? escapar(licencia.observacion) : "—")}
                </div>`
              : `<p class="mt-6 max-w-xl text-muted-foreground">Cargue su documento de identidad y su fotografía para que la directiva valide tu licencia.</p>`
          }
        </div>
      </section>

      <section>
        <div class="mb-6 flex items-center gap-4">
          <span class="checker-sm h-4 w-8" aria-hidden="true"></span>
          <h2 class="font-mono text-xs uppercase tracking-[0.3em] text-muted-foreground">Accesos</h2>
          <span class="h-px flex-1 bg-border" aria-hidden="true"></span>
        </div>

        <div class="grid gap-px bg-border md:grid-cols-2">
          ${acciones.join("")}
        </div>
      </section>`;
  }

  iniciar();
</script>
