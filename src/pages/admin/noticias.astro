---
import AdminLayout from "../../components/admin/AdminLayout.astro";

const categoriasSugeridas = ["Campeonato", "Escuelas", "Pistas", "Reglamento", "General"];
---

<AdminLayout title="Noticias — Panel de directiva" section="Noticias">
  <p class="font-mono text-xs uppercase tracking-[0.3em] text-muted-foreground">
    Comunicación oficial
  </p>
  <h1 class="mt-4 font-display text-6xl uppercase leading-[0.9] md:text-7xl">
    <span class="text-primary">Noticias</span> de la federación
  </h1>
  <p class="mt-6 max-w-2xl text-muted-foreground">
    Publicá los comunicados de la federación, editá los ya publicados y borrá los que quedaron
    desactualizados. Solo las noticias marcadas como publicadas se muestran en el sitio.
  </p>

  <div class="mt-12 grid gap-10 lg:grid-cols-[1fr_1.2fr]">
    <!-- Formulario -->
    <section class="border border-border bg-card">
      <div class="border-b border-border px-6 py-4">
        <h2 class="font-mono text-xs uppercase tracking-[0.3em] text-muted-foreground">
          <span id="titulo-formulario">Nueva noticia</span>
        </h2>
      </div>

      <form id="form-noticia" class="p-6">
        <div class="grid gap-5">
          <div class="grid gap-5 sm:grid-cols-2">
            <div>
              <label
                for="fecha"
                class="font-mono text-[10px] uppercase tracking-widest text-muted-foreground"
              >
                Fecha
              </label>
              <input
                id="fecha"
                name="fecha"
                type="text"
                placeholder="02 NOV 2026"
                required
                class="mt-2 w-full border bg-background px-4 py-3 outline-none focus:border-primary"
              />
            </div>
            <div>
              <label
                for="categoria"
                class="font-mono text-[10px] uppercase tracking-widest text-muted-foreground"
              >
                Categoría
              </label>
              <input
                id="categoria"
                name="categoria"
                type="text"
                list="categorias-sugeridas"
                placeholder="Campeonato"
                required
                class="mt-2 w-full border bg-background px-4 py-3 outline-none focus:border-primary"
              />
              <datalist id="categorias-sugeridas">
                {categoriasSugeridas.map((categoria) => <option value={categoria} />)}
              </datalist>
            </div>
          </div>

          <div>
            <label
              for="titulo"
              class="font-mono text-[10px] uppercase tracking-widest text-muted-foreground"
            >
              Título
            </label>
            <input
              id="titulo"
              name="titulo"
              type="text"
              placeholder="Presentado el calendario oficial"
              required
              class="mt-2 w-full border bg-background px-4 py-3 outline-none focus:border-primary"
            />
          </div>

          <div>
            <label
              for="resumen"
              class="font-mono text-[10px] uppercase tracking-widest text-muted-foreground"
            >
              Resumen
            </label>
            <textarea
              id="resumen"
              name="resumen"
              rows="4"
              placeholder="Dos o tres líneas con lo más importante del comunicado."
              required
              class="mt-2 w-full border bg-background px-4 py-3 outline-none focus:border-primary"
            ></textarea>
          </div>

          <label
            for="publicada"
            class="flex items-center justify-between gap-4 border border-border px-4 py-3"
          >
            <span>
              <span class="block font-mono text-[10px] uppercase tracking-widest text-muted-foreground">
                Publicada
              </span>
              <span class="mt-1 block text-sm text-muted-foreground">
                Si está activa, la noticia aparece en la home.
              </span>
            </span>
            <input id="publicada" name="publicada" type="checkbox" class="peer sr-only" />
            <span
              class="relative h-6 w-12 shrink-0 border border-foreground bg-background transition-colors peer-checked:bg-primary after:absolute after:top-0.5 after:left-0.5 after:h-5 after:w-5 after:bg-foreground after:transition-transform peer-checked:after:translate-x-6"
              aria-hidden="true"
            ></span>
          </label>
        </div>

        <div class="mt-6 flex flex-wrap gap-3">
          <button
            type="submit"
            id="guardar-noticia"
            class="bg-primary px-6 py-3 font-mono text-xs uppercase tracking-widest text-primary-foreground transition-opacity hover:opacity-90"
          >
            Publicar noticia
          </button>
          <button
            type="button"
            id="cancelar-edicion"
            class="hidden border border-foreground px-6 py-3 font-mono text-xs uppercase tracking-widest transition-colors hover:bg-foreground hover:text-background"
          >
            Cancelar edición
          </button>
        </div>

        <p
          id="mensaje-noticia"
          class="mt-4 hidden border px-4 py-3 font-mono text-xs uppercase tracking-widest"
          role="status"
        ></p>
      </form>
    </section>

    <!-- Listado -->
    <section>
      <div class="mb-6 flex items-center gap-4">
        <span class="checker-sm h-4 w-8" aria-hidden="true"></span>
        <h2 class="font-mono text-xs uppercase tracking-[0.3em] text-muted-foreground">
          Noticias cargadas
        </h2>
        <span class="h-px flex-1 bg-border" aria-hidden="true"></span>
      </div>

      <div id="lista-noticias" class="divide-y divide-border border-y border-border">
        <p class="py-6 font-mono text-xs uppercase tracking-widest text-muted-foreground">
          Cargando noticias…
        </p>
      </div>
    </section>
  </div>
</AdminLayout>

<script>
  import { esc, exigirDirectivo } from "../../components/admin/adminClient";
  import { validarNoticia } from "../../components/admin/adminLogica";
  import {
    actualizarNoticia,
    borrarNoticia,
    leerEstado,
    publicarNoticia,
  } from "../../lib/store";
  import type { Noticia } from "../../lib/types";

  const sesion = exigirDirectivo();

  const form = document.getElementById("form-noticia") as HTMLFormElement | null;
  const campoFecha = document.getElementById("fecha") as HTMLInputElement | null;
  const campoCategoria = document.getElementById("categoria") as HTMLInputElement | null;
  const campoTitulo = document.getElementById("titulo") as HTMLInputElement | null;
  const campoResumen = document.getElementById("resumen") as HTMLTextAreaElement | null;
  const campoPublicada = document.getElementById("publicada") as HTMLInputElement | null;
  const botonGuardar = document.getElementById("guardar-noticia");
  const botonCancelar = document.getElementById("cancelar-edicion");
  const tituloFormulario = document.getElementById("titulo-formulario");
  const mensaje = document.getElementById("mensaje-noticia");
  const lista = document.getElementById("lista-noticias");

  let noticiaEnEdicion: string | null = null;

  function mostrarMensaje(texto: string, ok: boolean): void {
    if (!mensaje) return;
    mensaje.textContent = texto;
    mensaje.classList.remove("hidden");
    mensaje.classList.toggle("border-primary", ok);
    mensaje.classList.toggle("text-primary", ok);
    mensaje.classList.toggle("border-destructive", !ok);
    mensaje.classList.toggle("text-destructive", !ok);
  }

  function limpiarFormulario(): void {
    form?.reset();
    if (campoPublicada) campoPublicada.checked = false;
    noticiaEnEdicion = null;
    if (botonGuardar) botonGuardar.textContent = "Publicar noticia";
    if (tituloFormulario) tituloFormulario.textContent = "Nueva noticia";
    botonCancelar?.classList.add("hidden");
  }

  function pintarLista(): void {
    if (!lista) return;
    const noticias: Noticia[] = leerEstado().noticias;

    if (noticias.length === 0) {
      lista.innerHTML =
        '<p class="py-6 font-mono text-xs tracking-wide text-muted-foreground">Todavía no hay noticias cargadas.</p>';
      return;
    }

    lista.innerHTML = noticias
      .map(
        (noticia) => `
        <article class="py-6" data-noticia-id="${esc(noticia.id)}">
          <div class="flex flex-wrap items-center gap-3 font-mono text-[10px] uppercase tracking-widest">
            <span class="text-muted-foreground">${esc(noticia.fecha)}</span>
            <span class="text-primary">${esc(noticia.categoria)}</span>
            <span class="border px-2 py-0.5 ${
              noticia.publicada
                ? "border-primary text-primary"
                : "border-border text-muted-foreground"
            }">${noticia.publicada ? "Publicada" : "Borrador"}</span>
          </div>
          <h3 class="mt-3 text-xl font-medium">${esc(noticia.titulo)}</h3>
          <p class="mt-2 text-sm text-muted-foreground">${esc(noticia.resumen)}</p>
          <div class="mt-4 flex gap-3">
            <button type="button" class="editar-noticia border border-foreground px-4 py-2 font-mono text-[10px] uppercase tracking-widest transition-colors hover:bg-foreground hover:text-background">
              Editar
            </button>
            <button type="button" class="borrar-noticia border border-border px-4 py-2 font-mono text-[10px] uppercase tracking-widest text-destructive transition-colors hover:border-destructive">
              Borrar
            </button>
          </div>
        </article>
      `,
      )
      .join("");
  }

  form?.addEventListener("submit", (evento) => {
    evento.preventDefault();
    if (!sesion) return;

    const datos = {
      fecha: (campoFecha?.value ?? "").trim(),
      categoria: (campoCategoria?.value ?? "").trim(),
      titulo: (campoTitulo?.value ?? "").trim(),
      resumen: (campoResumen?.value ?? "").trim(),
      publicada: Boolean(campoPublicada?.checked),
    };

    const validacion = validarNoticia(datos);
    if (!validacion.ok) {
      mostrarMensaje(validacion.error, false);
      return;
    }

    if (noticiaEnEdicion) {
      const actualizada = actualizarNoticia(noticiaEnEdicion, datos);
      if (!actualizada) {
        mostrarMensaje("No se encontró la noticia a editar", false);
        return;
      }
      mostrarMensaje("Noticia actualizada", true);
    } else {
      publicarNoticia(datos);
      mostrarMensaje("Noticia publicada", true);
    }

    limpiarFormulario();
    pintarLista();
  });

  botonCancelar?.addEventListener("click", () => {
    limpiarFormulario();
    mostrarMensaje("Edición cancelada", true);
  });

  lista?.addEventListener("click", (evento) => {
    const objetivo = evento.target as HTMLElement | null;
    const articulo = objetivo?.closest("[data-noticia-id]") as HTMLElement | null;
    if (!articulo) return;
    const id = articulo.getAttribute("data-noticia-id") ?? "";
    const noticia = leerEstado().noticias.find((item) => item.id === id);
    if (!noticia) return;

    if (objetivo?.classList.contains("editar-noticia")) {
      noticiaEnEdicion = noticia.id;
      if (campoFecha) campoFecha.value = noticia.fecha;
      if (campoCategoria) campoCategoria.value = noticia.categoria;
      if (campoTitulo) campoTitulo.value = noticia.titulo;
      if (campoResumen) campoResumen.value = noticia.resumen;
      if (campoPublicada) campoPublicada.checked = noticia.publicada;
      if (botonGuardar) botonGuardar.textContent = "Guardar cambios";
      if (tituloFormulario) tituloFormulario.textContent = `Editando: ${noticia.titulo}`;
      botonCancelar?.classList.remove("hidden");
      mostrarMensaje("Editando noticia", true);
      form?.scrollIntoView({ behavior: "smooth", block: "center" });
      return;
    }

    if (objetivo?.classList.contains("borrar-noticia")) {
      const confirmado = window.confirm(`¿Borrar la noticia "${noticia.titulo}"?`);
      if (!confirmado) return;
      borrarNoticia(noticia.id);
      if (noticiaEnEdicion === noticia.id) limpiarFormulario();
      mostrarMensaje("Noticia borrada", true);
      pintarLista();
    }
  });

  if (sesion) pintarLista();
</script>
