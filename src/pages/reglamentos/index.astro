---
import Base from "../../layouts/Base.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import { reglamentos } from "../../data/site";
---

<Base title="Reglamentos — Federación de Kartismo">
  <Header />

  <main class="mx-auto max-w-5xl px-5 py-24">
    <h1 class="font-display text-6xl uppercase leading-[0.9] md:text-7xl">Reglamentos</h1>
    <p class="mt-6 max-w-2xl text-lg text-muted-foreground">
      Normativa de la temporada 2027: formato de campeonato, homologación técnica,
      inscripciones y operación de pits.
    </p>

    <div class="mt-16 border-t border-border">
      {
        reglamentos.map((reglamento) => (
          <a
            href={`/reglamentos/${reglamento.slug}`}
            class="group grid gap-3 border-b border-border py-6 md:grid-cols-[1.1fr_1.4fr_auto] md:items-center md:gap-8"
          >
            <h2 class="font-display text-3xl uppercase leading-none transition-colors group-hover:text-primary">
              {reglamento.titulo}
            </h2>
            <p class="text-sm text-muted-foreground">{reglamento.resumen}</p>
            <span class="font-display text-2xl md:text-right" aria-hidden="true">
              →
            </span>
          </a>
        ))
      }
    </div>
  </main>

  <Footer />
</Base>
