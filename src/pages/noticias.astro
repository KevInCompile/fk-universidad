---
/**
 * T25 — Noticias de la federación (página pública).
 *
 * El listado es dinámico: se arma desde el store del navegador para que las
 * noticias publicadas desde el panel de directiva se reflejen acá. Las noticias
 * con `publicada: false` nunca se muestran.
 */
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import SectionHeading from "../components/SectionHeading.astro";
import { noticias } from "../data/site";
import { htmlListaNoticias, noticiasPublicadas } from "../components/home/home-data";
---

<Base
  title="Noticias de la federación — Federación de Kartismo"
  description="Novedades de la federación de kartismo: calendarios, homologaciones, licencias y campañas de las escuelas."
>
  <Header />

  <main>
    <section class="grain relative overflow-hidden border-b">
      <div
        class="absolute inset-0 bg-linear-to-t from-background via-background/40 to-transparent"
      >
      </div>

      <div
        class="relative mx-auto flex max-w-7xl flex-col justify-end px-5 pb-12 pt-24"
      >
        <p class="font-mono text-xs uppercase tracking-[0.3em] text-muted-foreground">
          04 · Noticias
        </p>
        <h1 class="font-display text-[16vw] uppercase leading-[0.9] md:text-8xl">
          Noticias
        </h1>
      </div>
    </section>

    <section class="mx-auto max-w-7xl px-5 py-24">
      <SectionHeading title="Noticias de la federación" />

      <ul
        id="noticias-lista"
        class="border-t border-border"
        set:html={htmlListaNoticias(noticiasPublicadas(noticias))}
      >
      </ul>

      <p
        id="noticias-vacio"
        class="hidden font-mono text-xs tracking-wide text-muted-foreground"
      >
        No hay noticias publicadas por el momento.
      </p>
    </section>
  </main>

  <Footer />
</Base>

<script>
  import { leerEstado } from "../lib/store";
  import { htmlListaNoticias, noticiasPublicadas } from "../components/home/home-data";

  const lista = document.getElementById("noticias-lista");

  if (lista) {
    const publicadas = noticiasPublicadas(leerEstado().noticias);
    lista.innerHTML = htmlListaNoticias(publicadas);
    lista.classList.toggle("hidden", publicadas.length === 0);
  }
</script>
