---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Federación de Kartismo — Pistas, eventos y campeonatos",
  description = "El punto oficial de información del kartismo: dónde correr, cuándo correr y cómo empezar.",
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Anton&family=Archivo:wght@400;500;700&family=JetBrains+Mono:wght@400;600&display=swap"
    />
  </head>
  <body class="min-h-screen bg-background font-sans text-foreground">
    <slot />
  </body>
</html>
