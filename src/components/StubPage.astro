---
import Base from "../layouts/Base.astro";
import Header from "./Header.astro";
import Footer from "./Footer.astro";

interface Props {
  title: string;
  eyebrow: string;
}

const { title, eyebrow } = Astro.props;
---

<Base>
  <Header />

  <main>
    <section class="grain relative min-h-[60vh] overflow-hidden border-b">
      <div
        class="absolute inset-0 bg-linear-to-t from-background via-background/40 to-transparent"
      >
      </div>

      <div
        class="relative mx-auto flex min-h-[60vh] max-w-7xl flex-col justify-end px-5 pb-12"
      >
        <p class="font-mono text-xs uppercase tracking-[0.3em] text-muted-foreground">
          {eyebrow}
        </p>
        <h1 class="font-display text-[16vw] uppercase leading-[0.9] md:text-8xl">{title}</h1>
      </div>
    </section>

    <section class="mx-auto max-w-7xl px-5 py-24">
      <p class="max-w-md text-muted-foreground">
        Prototipo: esta sección está en construcción. El contenido definitivo se cargará en la
        siguiente iteración.
      </p>
    </section>
  </main>

  <Footer />
</Base>
