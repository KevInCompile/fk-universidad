---
import Base from "../../layouts/Base.astro";

interface Props {
  titulo: string;
  descripcion?: string;
  eyebrow?: string;
  /** Muestra el botón de salida (las páginas con sesión de piloto). */
  mostrarSalir?: boolean;
  /** Oculta el título de la página al imprimir (vista tipo carnet). */
  tituloNoImprimir?: boolean;
}

const {
  titulo,
  descripcion = "Portal del piloto — Federación de Kartismo",
  eyebrow = "Portal del piloto",
  mostrarSalir = true,
  tituloNoImprimir = false,
} = Astro.props;
---

<Base title={`${titulo} — Federación de Kartismo`} description={descripcion}>
  <header class="no-print sticky top-0 z-50 border-b bg-background/90 backdrop-blur">
    <div class="mx-auto flex max-w-7xl items-center justify-between gap-4 px-5 py-3">
      <a href="/" class="flex items-center gap-3">
        <span class="checker block h-8 w-8 border border-foreground" aria-hidden="true"></span>
        <span class="font-display text-lg uppercase leading-none tracking-wide">
          Federación<br />
          <span class="text-primary">de Kartismo</span>
        </span>
      </a>

      <div class="flex items-center gap-4">
        <span
          class="hidden font-mono text-xs uppercase tracking-widest text-muted-foreground md:inline"
        >
          <span data-slot="sesion-nombre"></span>
        </span>

        {
          mostrarSalir ? (
            <button
              type="button"
              data-slot="salir"
              class="border border-foreground px-4 py-2 font-mono text-xs uppercase tracking-widest transition-colors hover:bg-foreground hover:text-background"
            >
              Salir
            </button>
          ) : (
            <a
              href="/login"
              class="border border-foreground px-4 py-2 font-mono text-xs uppercase tracking-widest transition-colors hover:bg-foreground hover:text-background"
            >
              Acceso
            </a>
          )
        }
      </div>
    </div>

    <div class="curb h-1" aria-hidden="true"></div>
  </header>

  <main class="mx-auto max-w-7xl px-5 py-12">
    <div class:list={["mb-10", tituloNoImprimir && "no-print"]}>
      <p class="font-mono text-xs uppercase tracking-[0.3em] text-primary">
        {eyebrow}
      </p>
      <h1 class="mt-3 font-display text-5xl uppercase leading-[0.9] md:text-7xl">
        {titulo}
      </h1>
    </div>

    <slot />
  </main>

  <footer class="no-print border-t">
    <div class="mx-auto flex max-w-7xl flex-col gap-2 px-5 py-10 md:flex-row md:items-center md:justify-between">
      <p class="font-mono text-xs uppercase tracking-widest text-muted-foreground">
        Federación de Kartismo · Temporada 2027
      </p>
      <nav class="flex gap-6">
        <a
          href="/piloto"
          class="font-mono text-xs uppercase tracking-widest text-muted-foreground transition-colors hover:text-primary"
        >
          Mi panel
        </a>
        <a
          href="/piloto/licencia"
          class="font-mono text-xs uppercase tracking-widest text-muted-foreground transition-colors hover:text-primary"
        >
          Licencia
        </a>
        <a
          href="/piloto/inscripciones"
          class="font-mono text-xs uppercase tracking-widest text-muted-foreground transition-colors hover:text-primary"
        >
          Inscripciones
        </a>
      </nav>
    </div>
  </footer>

  <script>
    import { leerSesion, escribirSesion } from "../../lib/store";

    const sesion = leerSesion();
    const nombre = document.querySelector('[data-slot="sesion-nombre"]');
    if (nombre && sesion) nombre.textContent = sesion.nombre;

    const salir = document.querySelector('[data-slot="salir"]');
    salir?.addEventListener("click", () => {
      escribirSesion(null);
      window.location.href = "/login";
    });
  </script>
</Base>
