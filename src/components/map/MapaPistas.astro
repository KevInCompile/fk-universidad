---
/**
 * Mapa real de las pistas homologadas (Leaflet + OpenStreetMap).
 * Decisión D3 del usuario: "Mapa real (Leaflet + OSM)".
 */
import { tracks } from "../../data/site";
---

<div class="relative">
  <div
    id="mapa-pistas"
    class="h-[420px] w-full border border-border md:h-[560px]"
    role="application"
    aria-label="Mapa de las pistas homologadas de la federación"
  >
  </div>

  <p class="mt-3 font-mono text-[10px] tracking-wide text-muted-foreground">
    Ubicación aproximada de cada complejo homologado · Datos de mapa © OpenStreetMap
  </p>
</div>

<script>
  import L from "leaflet";
  import "leaflet/dist/leaflet.css";
  import { tracks } from "../../data/site";

  const contenedor = document.getElementById("mapa-pistas");

  if (contenedor && !contenedor.dataset.iniciado) {
    contenedor.dataset.iniciado = "true";

    const mapa = L.map(contenedor, { scrollWheelZoom: false }).setView([6.1, -75.5], 5);

    L.tileLayer("https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png", {
      maxZoom: 19,
      attribution:
        '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>',
    }).addTo(mapa);

    const icono = L.divIcon({
      className: "",
      html: '<span style="display:block;width:18px;height:18px;background:var(--color-primary,#e94f37);border:2px solid #fff;box-shadow:0 0 0 1px rgba(0,0,0,.6)"></span>',
      iconSize: [18, 18],
      iconAnchor: [9, 9],
      popupAnchor: [0, -12],
    });

    const limites: [number, number][] = [];

    tracks.forEach((pista) => {
      const posicion: [number, number] = [pista.lat, pista.lng];
      limites.push(posicion);

      L.marker(posicion, { icon: icono, title: pista.name })
        .addTo(mapa)
        .bindPopup(
          `<div style="font-family:'JetBrains Mono',monospace;font-size:11px;letter-spacing:.08em;text-transform:uppercase">
            <p style="color:#e94f37;margin:0 0 6px">${pista.code} · ${pista.city}</p>
            <p style="font-family:Anton,Impact,sans-serif;font-size:20px;letter-spacing:0;text-transform:uppercase;margin:0 0 6px">${pista.name}</p>
            <p style="margin:0;color:#9a9a9a">${pista.length} · ${pista.corners} · récord ${pista.record}</p>
            <p style="margin:6px 0 0;color:#9a9a9a">${pista.direccion}</p>
          </div>`,
        );
    });

    if (limites.length > 1) {
      mapa.fitBounds(L.latLngBounds(limites).pad(0.25));
    }
  }
</script>
